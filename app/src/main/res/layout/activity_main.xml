<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:orientation="vertical"
    >

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="10dp"
        android:elevation="10dp"
        >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="5dp"
        >


        <TextView
            android:id="@+id/pc1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Prctice Challange 1"
            android:textSize="20sp"
            android:textStyle="bold"
            android:background="@drawable/marque_bg"
            android:gravity="center"
            android:layout_margin="10dp"
            />

            <TextView
                android:id="@+id/pc2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Prctice Challange 2"
                android:textSize="20sp"
                android:textStyle="bold"
                android:background="@drawable/marque_bg"
                android:gravity="center"
                android:layout_margin="10dp"
                />

            <TextView
                android:id="@+id/pc3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Prctice Challange 3"
                android:textSize="20sp"
                android:textStyle="bold"
                android:background="@drawable/marque_bg"
                android:gravity="center"
                android:layout_margin="10dp"
                />

            <TextView
                android:id="@+id/pc4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Prctice Challange 4"
                android:textSize="20sp"
                android:textStyle="bold"
                android:background="@drawable/marque_bg"
                android:gravity="center"
                android:layout_margin="10dp"
                />

            <TextView
                android:id="@+id/pc5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Prctice Challange 5"
                android:textSize="20sp"
                android:textStyle="bold"
                android:background="@drawable/marque_bg"
                android:gravity="center"
                android:layout_margin="10dp"
                />
            <TextView
                android:id="@+id/pc6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Prctice Challange 6"
                android:textSize="20sp"
                android:textStyle="bold"
                android:background="@drawable/marque_bg"
                android:gravity="center"
                android:layout_margin="10dp"
                />
            <TextView
                android:id="@+id/pc7"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Prctice Challange 7"
                android:textSize="20sp"
                android:textStyle="bold"
                android:background="@drawable/marque_bg"
                android:gravity="center"
                android:layout_margin="10dp"
                />
            <TextView
                android:id="@+id/pc8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Prctice Challange 8"
                android:textSize="20sp"
                android:textStyle="bold"
                android:background="@drawable/marque_bg"
                android:gravity="center"
                android:layout_margin="10dp"

                />
        <TextView
            android:id="@+id/pc9"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Prctice Challange 9"
            android:textSize="20sp"
            android:textStyle="bold"
            android:background="@drawable/marque_bg"
            android:gravity="center"
            android:layout_margin="10dp"
            />










    </LinearLayout>

    </androidx.cardview.widget.CardView>



    <!--bottomnavigation-->

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigationView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            app:menu="@menu/menu_navi_item"
            app:itemTextColor="#8A7070"
            android:background="@color/white"
            >

        </com.google.android.material.bottomnavigation.BottomNavigationView>

    <!--bottomnavigation-->




</RelativeLayout>