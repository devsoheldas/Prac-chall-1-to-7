<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Practice_Challange_3"
    >
    <!--home_page-->
    <RelativeLayout
        android:id="@+id/home_page"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="visible"
        >

    <!--First_Layout-->
    <RelativeLayout
        android:id="@+id/First_Layout"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        >
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/maldivs_1"
            android:scaleType="fitXY"
            />
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/search1"
            android:scaleType="fitXY"
            android:layout_alignParentRight="true"
            android:layout_margin="5dp"
            />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Where to? ∨"
                android:background="@drawable/two_color_curved"
                android:textStyle="bold"
                />

        </LinearLayout>

    </RelativeLayout>
    <!--First_Layout-->

    <!--Second_Layout-->
    <LinearLayout
        android:id="@+id/items_6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_below="@+id/First_Layout"

        >

        <!--Items_6-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:orientation="horizontal"
            android:weightSum="3"
            android:layout_margin="3dp"
            >

            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="100dp"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_weight="1"
                >

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardCornerRadius="10dp"
                    android:elevation="10dp"
                    android:layout_margin="2dp"

                    >

                    <LinearLayout
                        android:layout_width="fill_parent"
                        android:layout_height="100dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"

                        >

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginBottom="5dp"
                            android:src="@drawable/hotel"

                            />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hotels"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                    </LinearLayout>


                </androidx.cardview.widget.CardView>



            </LinearLayout>
            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="100dp"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_weight="1"
                >

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="10dp"
                    android:elevation="10dp"
                    android:layout_margin="2dp"
                    >
                    <LinearLayout
                        android:layout_width="fill_parent"
                        android:layout_height="100dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_weight="1"

                        >
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/baseline_vaca_24"
                            android:layout_marginBottom="5dp"

                            />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Vacation Rentals"
                            android:textStyle="bold"
                            android:textSize="15sp"

                            />

                    </LinearLayout>


                </androidx.cardview.widget.CardView>



            </LinearLayout>

            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="10dp"
                    android:elevation="10dp"
                    android:layout_margin="2dp"
                    >

                    <LinearLayout
                        android:layout_width="fill_parent"
                        android:layout_height="100dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        >

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/flight"
                            android:layout_marginBottom="5dp"

                            />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Flight"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            />
                    </LinearLayout>


                </androidx.cardview.widget.CardView>


            </LinearLayout>


        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:orientation="horizontal"
            android:weightSum="3"
            android:layout_margin="3dp"
            >

            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="100dp"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_weight="1"
                >

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="10dp"
                    android:elevation="10dp"
                    android:layout_margin="2dp"
                    >

                    <LinearLayout
                        android:layout_width="fill_parent"
                        android:layout_height="109dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginBottom="5dp"
                            android:src="@drawable/restaurant"

                            />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Restaurant"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                    </LinearLayout>


                </androidx.cardview.widget.CardView>



            </LinearLayout>
            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="100dp"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_weight="1"
                >

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="10dp"
                    android:elevation="10dp"
                    android:layout_margin="2dp"

                    >
                    <LinearLayout
                        android:layout_width="fill_parent"
                        android:layout_height="100dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_weight="1"
                        >

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/baseline_home_24"
                            android:layout_marginBottom="5dp"

                            />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="House"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            />

                    </LinearLayout>


                </androidx.cardview.widget.CardView>



            </LinearLayout>

            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="10dp"
                    android:elevation="10dp"
                    android:layout_margin="2dp"

                    >


                    <LinearLayout
                        android:layout_width="fill_parent"
                        android:layout_height="100dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/more"
                            android:layout_marginBottom="5dp"

                            />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="More"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            />

                    </LinearLayout>


                </androidx.cardview.widget.CardView>


            </LinearLayout>


        </LinearLayout>
        <!--Items_6-->


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:text="Top Destination"
            android:layout_marginLeft="10dp"
            android:textSize="20sp"
            />

        <!--HorizontalScrollView-->

        <LinearLayout
            android:id="@+id/Image_ScrollView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            >
            <HorizontalScrollView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_margin="5dp"

                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:orientation="horizontal"

                    >

                    <ImageView
                        android:layout_width="200dp"
                        android:layout_height="match_parent"
                        android:layout_margin="5dp"
                        android:scaleType="fitXY"
                        android:src="@drawable/p1" />

                    <ImageView
                        android:layout_width="200dp"
                        android:layout_height="match_parent"
                        android:layout_margin="5dp"
                        android:scaleType="fitXY"
                        android:src="@drawable/p2" />

                    <ImageView
                        android:layout_width="200dp"
                        android:layout_height="match_parent"
                        android:src="@drawable/p3"
                        android:scaleType="fitXY"
                        android:layout_margin="5dp"
                        />

                    <ImageView
                        android:layout_width="200dp"
                        android:layout_height="match_parent"
                        android:layout_margin="5dp"
                        android:scaleType="fitXY"
                        android:src="@drawable/p4" />

                    <ImageView
                        android:layout_width="200dp"
                        android:layout_height="match_parent"
                        android:src="@drawable/p5"
                        android:scaleType="fitXY"
                        android:layout_margin="5dp"
                        />
                    <ImageView
                        android:layout_width="200dp"
                        android:layout_height="match_parent"
                        android:src="@drawable/p6"
                        android:scaleType="fitXY"
                        android:layout_margin="5dp"
                        />








                </LinearLayout>
            </HorizontalScrollView>

        </LinearLayout>

        <!--HorizontalScrollView-->


    </LinearLayout>
    <!--Second_Layout-->



    </RelativeLayout>
    <!--home_page-->

    <!--my_trip_page-->
    <RelativeLayout
        android:id="@+id/my_trip_page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        >
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="My Trip Page"
            android:gravity="center"
            android:textSize="20sp"
            android:background="#009688"
            />


    </RelativeLayout>
    <!--my_trip_page-->

    <!--aleart_page-->
    <RelativeLayout
        android:id="@+id/aleart_page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#FFEB3B"
        >
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Aleart Page"
            android:gravity="center"
            android:textSize="20sp"
            />


    </RelativeLayout>
    <!--aleart_page-->


    <!--me_page-->
    <RelativeLayout
        android:id="@+id/me_page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#03A9F4"
        >
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Me Page"
            android:gravity="center"
            android:textSize="20sp"
            />


    </RelativeLayout>
    <!--me_page-->


    <!--BottomNavigationView-->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        app:menu="@menu/pc3_bottom_navi_item"
        android:id="@+id/bottomNavigationView"
        >
    </com.google.android.material.bottomnavigation.BottomNavigationView>
    <!--BottomNavigationView-->




</RelativeLayout>