<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Practice_Challange_7"
    android:orientation="vertical"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            >

            <!--....vertical  LinearLayout....-->

            <ScrollView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                >
                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    app:cardCornerRadius="5dp"
                    >
                    <LinearLayout
                        android:layout_width="150dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"

                        >

                        <ImageView
                            android:id="@+id/tamim"
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            android:src="@drawable/tamim"
                            android:scaleType="fitXY"
                            />
                        <ImageView
                            android:id="@+id/sakib"
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            android:src="@drawable/sakib"
                            android:scaleType="fitXY"
                            />
                        <ImageView
                            android:id="@+id/liton"
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            android:src="@drawable/litton"
                            android:scaleType="fitXY"
                            />

                        <ImageView
                            android:id="@+id/soumma"
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            android:scaleType="fitXY"
                            android:src="@drawable/soumma" />
                        <ImageView
                            android:id="@+id/sohel"
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            android:scaleType="fitXY"
                            android:src="@drawable/tamim" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </ScrollView>

            <!--....vertical  LinearLayout....-->

            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardCornerRadius="5dp"
                android:layout_margin="5dp"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    >

                    <!--.......Tamim Iqbal ......-->
                    <ScrollView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        >

                        <LinearLayout
                            android:id="@+id/Tamim_L"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:visibility="visible"
                            >
                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="300dp"
                                android:src="@drawable/tamim"
                                android:scaleType="fitXY"
                                />
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textStyle="bold"
                                android:text="Tamim Iqbal Khan "
                                android:textSize="30sp"
                                android:layout_marginLeft="5dp"
                                />
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textStyle="bold"
                                android:text="Left handed opeaning batter "
                                android:textSize="18sp"
                                android:layout_marginLeft="5dp"
                                android:textColor="#136521"
                                />
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textStyle="normal"
                                android:text="Tamim was born to Iqbal Khan and Nusrat Iqbal Khan, in the port
                    city of Chittagong.[11] His paternal Khan family is a prestigious family in the
                     city, his ancestors arrived to Chittagong from Bihar.[11][12][13] His maternal
                     family belongs to Salempur in Uttar Pradesh.[14][15] Tamim is the brother of
                     Nafees Iqbal and the nephew of Akram Khan, who both played Test cricket for Bangladesh.
                     [11]Tamim's father, Iqbal, used to host small cricket tournaments to help his sons train and get better
                      in cricket.[12] His brother Nafees, a former national team cricketer, in an interview said,
                       Tamim was the more talented one.
                     When Tamim was 12 or 13, he hit 148 as the team chased 150"
                                android:textSize="15sp"
                                android:layout_marginLeft="5dp"
                                android:textColor="#0E6671"
                                android:gravity="left"
                                />

                        </LinearLayout>



                    </ScrollView>
                    <!--.......Tamim Iqbal ......-->

                    <!--...........Sakib ......-->
                    <ScrollView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        >
                        <androidx.cardview.widget.CardView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="5dp"
                            app:cardCornerRadius="5dp"

                            >
                            <LinearLayout
                                android:id="@+id/Sakib_L"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:visibility="gone"
                                >
