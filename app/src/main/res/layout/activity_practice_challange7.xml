                                android:textSize="15sp"
                                android:layout_marginLeft="5dp"
                                android:textColor="#0E6671"
                                android:gravity="left"
                                />




                        </LinearLayout>

                    </ScrollView>
                    <!--........Sohel  Das ......-->


                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>